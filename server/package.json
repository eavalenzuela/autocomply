{
  "name": "autocomply-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent node --import tsx --test src/scoring.test.ts src/ratelimit.test.ts src/catalog.test.ts src/evidence.test.ts",
    "test:unit": "LOG_LEVEL=silent node --import tsx --test src/scoring.test.ts src/ratelimit.test.ts src/evidence.test.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "db:collect": "tsx src/collectors/simulate.ts",
    "db:docs": "tsx src/collectors/simulate-docs.ts",
    "db:monitor": "tsx src/collectors/monitor.ts",
    "catalog:dump": "tsx src/catalog-dump.ts",
    "loader:check": "tsx src/loader-check.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:baseline": "tsx src/baseline.ts",
    "test:http": "LOG_LEVEL=silent node --import tsx --test src/http.test.ts",
    "db:fk-check": "tsx src/fk-check.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pg": "^8.12.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
